# Copy to .env and fill in. The TUI reports "R2 not configured" until these are set.

# Cloudflare account containing the R2 bucket (32-char hex account id, not the bucket id).
R2_ACCOUNT_ID=

# R2 bucket to store processed variants.
R2_BUCKET_NAME=

# Public base URL of the bucket so the browser can load images.
# Use the bucket's r2.dev subdomain (Settings > Public access) or a custom domain.
# Example: https://pub-1a2b3c4d5e6f7g8h.r2.dev  (no trailing slash)
R2_PUBLIC_URL=

# S3-compatible API credentials for the bucket (R2 > Manage R2 API Tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
