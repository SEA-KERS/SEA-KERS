{
  "name": "team-sea-kers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@sea-kers/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "pnpm --filter @sea-kers/web test:watch",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "pnpm --filter @sea-kers/web preview",
    "deploy": "pnpm --filter @sea-kers/web deploy",
    "deploy:cache": "pnpm --filter @sea-kers/turbo-cache deploy",
    "audit:lighthouse": "pnpm --filter @sea-kers/web audit:lighthouse",
    "cf-typegen": "pnpm --filter @sea-kers/web cf-typegen",
    "cms": "pnpm --filter @sea-kers/cms cli",
    "cms:scan": "pnpm --filter @sea-kers/cms cli scan",
    "cms:upload": "pnpm --filter @sea-kers/cms cli upload",
    "cms:generate": "pnpm --filter @sea-kers/cms cli generate"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
