{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-sea-kers",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "team-seakers.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
